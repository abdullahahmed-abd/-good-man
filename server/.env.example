# ==========================================
# Insaan Backend Environment Variables
# ==========================================

# Server Port & Environment
PORT=3001
NODE_ENV=development

# Database Connection (Neon PostgreSQL with SSL)
DATABASE_URL=postgresql://user:password@ep-cool-sample.us-east-2.aws.neon.tech/insaan?sslmode=require

# JWT Secrets (Generate with `openssl rand -hex 32`)
JWT_ACCESS_SECRET=your_super_secret_jwt_access_token_key_at_least_32_characters_long
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_token_key_at_least_32_characters_long

# Frontend URLs for strict CORS and Links
FRONTEND_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173

# Resend API Key for Email Verification & Password Reset
# In development, leave blank or as placeholder to log verification links to console
RESEND_API_KEY=re_placeholder_key_in_dev
EMAIL_FROM=Insaan <noreply@insaan.app>
